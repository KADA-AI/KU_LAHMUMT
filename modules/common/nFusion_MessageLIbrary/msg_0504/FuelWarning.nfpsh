# MissionID 0504 연료량 경고

ulong timestamp:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 2000년 1월 1일부터 ms

string source:
 - 비고 : 메시지를 전송하는 모듈 이름

uint aircraftID:
 - 길이 : 4
 - unit : N/A
 - 비고 : 해당 무인기 ID

uint fuelLevel:
 - 길이 : 4
 - unit : N/A
 - 비고 : 연료량 수준
 - enum : 1=Yellow(잔여 연료량 20%), 2=RED(잔여 연료량 10%)
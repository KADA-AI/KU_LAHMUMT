# MessageID 0902 재계획 요청

ulong timestamp:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 2000년 1월 1일부터 ms

string source:
 - 비고 : 메시지를 전송하는 모듈 이름

ReplanRequestTime replanRequestTime:
uint replanLevel:
 - 길이 : 4
 - min : 0
 - Max : 4
 - unit : N/A
 - 비고 : 재계획 수준
 - enum : 0=None, 1=전체 임무 재계획, 2=협업기저임무, 3=비행/촬용 재계획, 4=선행임무 반영

List<InputMissionID> inputMissionIDList
List<IndividualMissionID> individualMissionIDList
 - alias : IndividualMissionIDList (legacy camel-case)
List<CommonType.PriorMission> priorMissionList
string replanRequest:
 - 길이 : Variable
 - unit : N/A
 - 비고 : 재계획 근거
 - alias : replanReason (legacy field name)

List<CommonType.PendingOption> optionList
 - alias : pendingOptionList (legacy field name)

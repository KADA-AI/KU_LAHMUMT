# MessageID 0801 운용자 임무재계획 명령

ulong timestamp:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 2000년 1월 1일부터 ms

string source:
 - 비고 : 메시지를 전송하는 모듈 이름

ulong operatorReplanRequestTime:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 운용자 임무재계획 요청 시점

uint inputMissionPackageID:
 - 길이 : 4
 - unit : N/A
 - 비고 : 계획할 협업기저임무 패키지 ID

uint missionReferencePackageID:
 - 길이 : 4
 - unit : N/A
 - 비고 : 연계된 비행참조정보 패키지 ID
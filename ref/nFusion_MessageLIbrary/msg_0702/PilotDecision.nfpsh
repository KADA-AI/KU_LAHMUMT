# MessageID 0702 의사결정 결과

ulong timestamp:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 2000년 1월 1일부터 ms

string source:
 - 비고 : 메시지를 전송하는 모듈 이름

uint ignore:
 - 길이 : 4
 - min : 0
 - Max : 2
 - unit : N/A
 - 비고 : 임무수행변경 여부
 - enum : 0=None, 1=기존임무수행, 2=MissionPlanID로 선택

uint missionPlanID:
 - 길이 : 4
 - unit : N/A
 - 비고 : 수행할 임무 계획 ID
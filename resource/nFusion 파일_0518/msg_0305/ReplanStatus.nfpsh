# MissionID 0305 재계획 수행 상태 정보

ulong timestamp:
 - 길이 : 8
 - min : 0
 - Max : 2^64-1
 - unit : ms
 - 비고 : 2000년 1월 1일부터 ms

string source:
 - 비고 : 메시지를 전송하는 모듈 이름

uint missionPlanningStatus:
 - 길이 : 4
 - min : 0
 - Max : 2
 - unit : N/A
 - 비고 : 임무 재계획 수행 상태 정보
 - enum : 0=Unknown, 1=재계획 수행 중이지 않음, 2=재계획 수행 중, 3=재계획 실패

string replanReason:
 - 길이 : 128
 - unit : N/A
 - 비고 : 재계획 근거, 한글은 3바이트, 영문은 1바이트
uint waypointID:
 - 길이 : 4
 - min : 0
 - Max : 2^16-1
 - unit : N/A
 - 비고 : 경로점ID

CommonType.Coordinate coordinate
float speed:
 - 길이 : 4
 - min : 0
 - Max : 1000
 - unit : m/s
 - 비고 : 경로점 목표 속도

uint eta:
 - 길이 : 4
 - min : 0
 - Max : 2^32-1
 - unit : sec
 - 비고 : 예상 도착 시간. 해당 비행 계획 내에서만 예측 -> 첫 WP에서는 0으로 고정 -> 이후 시간이 더해짐

float ecf:
 - 길이 : 4
 - min : 0
 - Max : 1000
 - unit : Liter
 - 비고 : 해당 구간 (이전WP -> 이 WP)을 비행하는 동안 소모할 것으로 예상되는 연료량

uint nextWaypointID:
 - 길이 : 4
 - min : 0
 - Max : 2^16-1
 - unit : N/A
 - 비고 : 다음 경로점 ID

